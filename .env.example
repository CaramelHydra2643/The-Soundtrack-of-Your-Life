# ==============================================================================
# THE SOUNDTRACK OF YOUR LIFE - CONFIGURATION
# ==============================================================================
# Copy this file to .env and customize as needed
# DO NOT commit .env to version control

# ------------------------------------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_NAME="The Soundtrack of Your Life"
APP_ENV=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# LLM CONFIGURATION
# ------------------------------------------------------------------------------
# Provider: ollama (default), openai (future), anthropic (future)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
LLM_TIMEOUT=180
LLM_TEMPERATURE=0.3
# Keep structured analysis compact for faster CPU responses.
LLM_MAX_TOKENS=1000
# A second LLM explanation is slower; deterministic grounded explanations are the default.
ENABLE_LLM_EXPLANATIONS=false

# ------------------------------------------------------------------------------
# EMBEDDING CONFIGURATION
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Device: cpu, cuda, mps (auto-detected if left empty)
EMBEDDING_DEVICE=cpu

# ------------------------------------------------------------------------------
# VECTOR DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
VECTOR_STORE=chroma
# Leave empty to use default app data directory
VECTOR_DB_PATH=
COLLECTION_NAME=music_knowledge
RETRIEVAL_TOP_K=5

# ------------------------------------------------------------------------------
# RECOMMENDATION ENGINE SETTINGS
# ------------------------------------------------------------------------------
MAX_RECOMMENDATIONS=5
MAX_MEMORY_LENGTH=5000

# Scoring weights (must sum to 1.0)
WEIGHT_MOOD=0.25
WEIGHT_GENRE=0.20
WEIGHT_LANGUAGE=0.15
WEIGHT_INSTRUMENT=0.10
WEIGHT_THEME=0.10
WEIGHT_AUDIO=0.10
WEIGHT_PERSONAL=0.10

# ------------------------------------------------------------------------------
# OPTIONAL FEATURES
# ------------------------------------------------------------------------------
# Enrich only selected recommendations with iTunes and optional Spotify metadata.
# External failures never block soundtrack generation.
ENABLE_EXTERNAL_MUSIC_LOOKUP=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Enable memory vault feature
ENABLE_MEMORY_VAULT=true

# ------------------------------------------------------------------------------
# DATA STORAGE
# ------------------------------------------------------------------------------
# Leave empty to use platformdirs default
# Windows: %LOCALAPPDATA%\The Soundtrack of Your Life
# Linux: ~/.local/share/soundtrack-of-your-life
# macOS: ~/Library/Application Support/The Soundtrack of Your Life
APP_DATA_DIR=

# Database filename
DB_NAME=memories.db
